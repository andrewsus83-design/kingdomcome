# ─────────────────────────────────────────────────────────────────────────────
# Kingdom Come — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Magisterium AI (Catholic AI Chat) ────────────────────────────────────────
MAGISTERIUM_API_KEY=your-magisterium-api-key-here

# ── Anthropic / Claude (Orchestrator) ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Saint Character Assets ───────────────────────────────────────────────────
# No API key needed — upload saint character art manually to R2/Supabase Storage
# Asset URL pattern: https://assets.kingdomcome.app/saints/{saint-name-slug}.png

# ── Modal.com (Image Generation + TTS + Music) ───────────────────────────────
MODAL_API_KEY=your-modal-api-key-here
MODAL_TTS_URL=https://{your-modal-username}--kingdom-come-tts.modal.run/narrate
MODAL_MUSIC_URL=https://{your-modal-username}--kingdom-come-music.modal.run/generate

# ── Runway Gen 4.5 (Video Generation) ────────────────────────────────────────
RUNWAY_API_KEY=your-runway-api-key-here

# ── HeyGen (Avatar Storytelling) ─────────────────────────────────────────────
HEYGEN_API_KEY=your-heygen-api-key-here

# ── World Anvil (Wiki / World Builder) ───────────────────────────────────────
WORLD_ANVIL_API_KEY=your-world-anvil-api-key-here
WORLD_ANVIL_WORLD_ID=your-world-anvil-world-id-here

# ── ElevenLabs (Voice Narration / TTS) ───────────────────────────────────────
ELEVENLABS_API_KEY= # ElevenLabs TTS - get at elevenlabs.io/app/settings/api-keys

# ── Cloudflare Worker (API Proxy / Edge) ─────────────────────────────────────
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
